# Отримати токен від @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Свій Telegram ID (покаже /start)
OWNER_ID=

# Базова сума для /invest (USD)
BASE_AMOUNT=100

# Котирувальна валюта пари
QUOTE=USDT

# Кількість сходинок у драбинці (1-3)
RUNGS=3

# Мінімальний розмір ордера в USD (~$5 на Bybit)
MIN_NOTIONAL=5

# Мінімальний "осмислений" ордер (USD): менше — не ставити, об'єднувати в один
MIN_ORDER=25

# Кількість днів до "застряглого" ордера
STALE_DAYS=14

# Шлях до SQLite-бази
DB_PATH=invest_bot.db

# Пороги алертів
CAPITULATION_DROP=0.08
GOOD_MOMENT_SCORE=60
GREED_FNG=80

# Власний CA-bundle (тільки якщо є корпоративний TLS-проксі). Інакше — порожньо.
CA_BUNDLE=

# AI-порадник Google Gemini (безкоштовний ключ: https://aistudio.google.com/apikey)
# Порожній ключ = AI вимкнено, бот працює лише на формулі.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Запасна модель, якщо основна перевантажена (503/429). Порожньо = без запасної.
# ВАЖЛИВО: має ВІДРІЗНЯТИСЯ від GEMINI_MODEL, інакше запасної фактично немає.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Ключі бірж для ЧИТАННЯ залишків (необовʼязково; порожньо = бот працює як раніше).
# Створювати тільки read-only: без торгівлі й без виводу, з привʼязкою до IP сервера.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
BYBIT_API_KEY=
BYBIT_API_SECRET=
